<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>&lt;label&gt;</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/with-secrets</string>
    <string>ORCA_BRIDGE_HTTP_TOKEN</string>
    <string>--</string>
    <string>/ABSOLUTE/PATH/orca-bridge-http</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
